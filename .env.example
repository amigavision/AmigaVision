# Destination directory
AGSDEST=${HOME}/Developer/AV-Output

# Temporary directory used during image creation
AGSTEMP=${AGSDEST}/tmp

# Directory for ROMs and WHDLoad content
AGSCONTENT=${HOME}/Developer/AV-Content

# Native DH0 source (defaults to the AV-Base checkout alongside AmigaVision)
# AGSBASE=${HOME}/Developer/AV-Base

# Path to kickstart ROM
FSUAEROM=${AGSCONTENT}/base/kickstart.rom

# Path to fs-uae binary
FSUAEBIN=/Applications/FS-UAE.app/Contents/MacOS/fs-uae

# Optional archive fetch settings
# ARCHIVE_FETCH_REMOTE=
# ARCHIVE_FETCH_LOGIN_CMD='mega-login {remote}'
# ARCHIVE_FETCH_LIST_CMD='mega-find / --pattern=*.lha'
# ARCHIVE_FETCH_LIST_LONG_CMD='mega-ls -R -l /'
# ARCHIVE_FETCH_GET_CMD='mega-get {path} {dest}'
# ARCHIVE_FETCH_LOGOUT_CMD='mega-logout'
# ARCHIVE_FETCH_CUTOFF_DAYS=10
