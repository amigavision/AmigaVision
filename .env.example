# Destination directory
AVSDEST=${HOME}/Developer/AV-Output

# Temporary directory used during image creation
AVSTEMP=${AVSDEST}/tmp

# Directory for ROMs and WHDLoad content
AVSCONTENT=${HOME}/Developer/AV-Content

# Native DH0 source (defaults to the AV-Base checkout alongside AmigaVision)
# AVSBASE=${HOME}/Developer/AV-Base

# Path to kickstart ROM
KICKSTART_ROM=${AVSCONTENT}/base/kickstart.rom

