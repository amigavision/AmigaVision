avs-cd N/HopToTheTop
IF EXISTS WHDSaves:HopToTheTop/highscores.dat
  copy WHDSaves:HopToTheTop/highscores.dat highscores.dat CLONE QUIET
ENDIF
stack >NIL: 65536
assign HopToTheTop: ""
HopToTheTop >NIL:
avs-cd N/HopToTheTop
assign HopToTheTop: REMOVE
IF EXISTS highscores.dat
  IF NOT EXISTS WHDSaves:HopToTheTop
    makedir WHDSaves:HopToTheTop
  ENDIF
  copy highscores.dat WHDSaves:HopToTheTop/highscores.dat CLONE QUIET
ENDIF
