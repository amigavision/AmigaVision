avs-cd N/Ecliptic
stack >NIL: 65536
IF EXISTS WHDSaves:Ecliptic/save.lst
  copy WHDSaves:Ecliptic/save.lst save.lst QUIET
ENDIF
Ecliptic >NIL:
avs-cd N/Ecliptic
IF NOT EXISTS WHDSaves:Ecliptic
  makedir WHDSaves:Ecliptic
ENDIF
IF EXISTS save.lst
  copy save.lst WHDSaves:Ecliptic/save.lst QUIET
ENDIF
