  IF NOT EXISTS "WHDSaves:SolomonsKeyST"
    makedir "WHDSaves:SolomonsKeyST"
  ENDIF
  copy "sk.cfg" "WHDSaves:SolomonsKeyST/sk.cfg" CLONE QUIET
