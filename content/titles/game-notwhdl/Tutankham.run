avs-cd N/Tutankham
IF EXISTS "WHDSaves:Tutankham/TopScores"
  copy "WHDSaves:Tutankham/TopScores" "TopScores" CLONE QUIET
ENDIF
stack >NIL: 65536
Tutankham >NIL:
avs-cd N/Tutankham
IF EXISTS "TopScores"
  IF NOT EXISTS "WHDSaves:Tutankham"
    makedir "WHDSaves:Tutankham"
  ENDIF
  copy "TopScores" "WHDSaves:Tutankham/TopScores" CLONE QUIET
ENDIF
