avs-cd N/SantaRocks
IF EXISTS WHDSaves:SantaRocks/scores.dat
  copy WHDSaves:SantaRocks/scores.dat scores.dat CLONE QUIET
ENDIF
stack >NIL: 65536
SantaRocks >NIL:
avs-cd N/SantaRocks
IF EXISTS scores.dat
  IF NOT EXISTS WHDSaves:SantaRocks
    makedir WHDSaves:SantaRocks
  ENDIF
  copy scores.dat WHDSaves:SantaRocks/scores.dat CLONE QUIET
ENDIF
