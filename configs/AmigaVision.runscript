ags-notify TITLE="{{TITLE}}"
ags-cd "{{PATH}}"
{{SPLASH_DELAY_SETUP}}
IF NOT EXISTS ENV:whdlqtkey
  echo "" >ENV:whdlqtkey
ENDIF
IF EXISTS ENV:whdlvmode
  whdload >NIL: "{{SLAVE}}" $whdlvmode {{CUST_ARGS}} SplashDelay={{SPLASH_DELAY}}{{CONFIG_DELAY}} {{QUIT_KEY}}
ELSE
  IF NOT EXISTS ENV:disable_vadjust
    ags-vadjust s={{VADJUST_SCALE}} v={{VADJUST_VSHIFT}} h={{VADJUST_HSHIFT}} {{VADJUST_SACHS}}
  ENDIF
  whdload >NIL: "{{SLAVE}}" {{VIDEO_MODE}} {{CUST_ARGS}} SplashDelay={{SPLASH_DELAY}}{{CONFIG_DELAY}} {{QUIT_KEY}}
  IF NOT EXISTS ENV:disable_vadjust
    ags-vadjust
  ENDIF
ENDIF
ags-notify
