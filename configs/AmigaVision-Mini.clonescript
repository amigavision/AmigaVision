stack 32768
stack
echo "" >RAM:OK
echo "AmigaVision image clone"
if exists tmp:clone-progress
  type tmp:clone-progress
endif
echo ""
echo "Formatting DH0: Amiga..."
pfsformat drive DH0: name "Amiga" quick noicons filenamesize=96 <RAM:OK
echo ""
echo "Formatting DH1: Data..."
pfsformat drive DH1: name "Data" quick noicons filenamesize=96 <RAM:OK
echo ""
echo "Cloning DH0..."
copy tmp:DH0/#? DH0: all clone quiet
if exists tmp:DH1/AVS
  echo "Cloning DH1: launcher..."
  copy tmp:DH1/AVS DH1:AVS all clone quiet
endif
if exists tmp:DH1/AVS-MedRes
  echo "Cloning DH1: medium-resolution launcher..."
  copy tmp:DH1/AVS-MedRes DH1:AVS-MedRes all clone quiet
endif
if exists tmp:DH1/Disk.info
  echo "Cloning DH1: disk icon..."
  copy tmp:DH1/Disk.info DH1: clone quiet
endif
if exists tmp:DH1/WHD
  echo "Cloning DH1: WHD (D/G/M/N)..."
  copy tmp:DH1/WHD/#? DH1:WHD all clone quiet
endif
if exists tmp:DH1/Music
  echo "Cloning DH1: Music..."
  copy tmp:DH1/Music DH1:Music all clone quiet
endif
; PFS delays writes. The small BGM copy can remain entirely cached at exit.
; Wait is not on the boot ADF, so run the staged system's command explicitly.
tmp:DH0/C/Wait 5
if exists "DH1:Music/Jan Reinert Karlsen (Interphace) - To the Beach.mod"
  if exists "DH1:Music/7 Launcher BGM"
    echo "OK" >tmp:mini-bgm.status
  else
    echo "ERROR: launcher BGM directory was not copied" >tmp:mini-bgm.status
  endif
else
  echo "ERROR: required root Music module was not copied" >tmp:mini-bgm.status
endif
echo ""
echo "Done!"
UAEquit
